# Folio — response headers (Cloudflare Pages)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: browsing-topics=()

# Framing is denied where credentials or the personal shelf live. The
# pdf.js viewer (/assets/pdfjs/...) is intentionally absent from these
# rules so /app/read can embed it in a same-origin iframe.
/app/*
  X-Frame-Options: DENY
/tokens.html
  X-Frame-Options: DENY

# The site is edited and deployed often; assets carry an ETag, so a short
# TTL + must-revalidate gives 304s instead of a full day of stale JS/CSS.
/assets/*
  Cache-Control: public, max-age=300, must-revalidate
/lib/*
  Cache-Control: public, max-age=300, must-revalidate
/app/lib/*
  Cache-Control: public, max-age=300, must-revalidate
